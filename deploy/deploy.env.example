# ============================================================
# ccmax Docker 部署配置样例
#
# 用法：
#   cp deploy/deploy.env.example /srv/ccmax-runtime/deploy.env
#   vi /srv/ccmax-runtime/deploy.env
#   deploy/service.sh start -c /srv/ccmax-runtime/deploy.env --dry-run
#   deploy/service.sh start -c /srv/ccmax-runtime/deploy.env
#
# 说明：
#   * 本文件由 deploy/service.sh 以严格 `KEY=value` 方式解析，不会被 source 执行；
#     反引号、命令替换和未登记键都会直接报错，避免配置里藏 shell 逻辑。
#   * 这里只放非密钥配置。密钥（provider token 等）放在单独的密钥文件里，
#     通过 CCMAX_SECRETS_FILE 指定，权限必须为 0600，脚本只输出哈希不输出值。
#     密钥文件不得覆盖 HOME / CLAUDE_CONFIG_DIR / SERVER_PORT / PATH / NODE_OPTIONS
#     等容器固定或 bootstrap 变量，也不允许键名重复。
#   * 本脚本不创建目录、不迁移数据、不构建镜像；镜像需先由镜像流程产出。
#   * 挂载结构（config / workspace 源目录）一旦部署就不能通过配置变更：目录变化必须
#     人工迁移，脚本会明确拒绝而不是静默换 mount（--allow-reconfigure 也不放开挂载）。
# ============================================================

# -------- 镜像（必填）--------
# 必须是带精确 tag 或 @sha256 digest 的镜像引用；禁止 :latest 与隐式 tag。
CCMAX_IMAGE=ccmax:local

# -------- 运行时目录（必填）--------
# 绝对路径，且必须已存在（脚本不会自动创建）。推荐布局：
#   <runtime>/config     -> 容器内 /config
#   <runtime>/workspace  -> 容器内 /workspace
#   <runtime>/backups    -> 更新前的完整备份归档（脚本以 0700 创建目录、0600 写归档）
# 请把下面示例替换为部署方自己的实际路径。
CCMAX_RUNTIME_DIR=/srv/ccmax-runtime

# 运行时子目录名（单层相对名，默认即可）
CCMAX_CONFIG_SUBDIR=config
CCMAX_WORKSPACE_SUBDIR=workspace
CCMAX_BACKUP_SUBDIR=backups

# -------- 网络与端口 --------
# 宿主端口；容器内监听端口由 CCMAX_CONTAINER_PORT 决定（会注入 SERVER_PORT）。
CCMAX_PORT=18081
CCMAX_CONTAINER_PORT=18081
# bridge（默认，做端口映射）或 host（不做端口映射，直接使用宿主机网络栈）
CCMAX_NETWORK_MODE=bridge

# -------- 容器运行参数 --------
# 容器名，默认 ccmax；同一台宿主机上多个实例请用不同名字与运行时目录。
CCMAX_CONTAINER_NAME=ccmax
# 容器内进程用户，默认 1000:1000；config/workspace 目录属主需与之匹配。
CCMAX_UID=1000
CCMAX_GID=1000
# 重启策略；unless-stopped 表示宿主重启后自动恢复。
CCMAX_RESTART_POLICY=unless-stopped
# 停止超时（秒）；update/stop/rollback 用 docker stop --time 传递。
CCMAX_STOP_TIMEOUT=60
# 使用 init 进程回收僵尸进程（推荐 true）。
CCMAX_INIT=true
# 增加 no-new-privileges（推荐 true；脚本不会使用 privileged 或挂载 docker socket）。
CCMAX_NO_NEW_PRIVILEGES=true

# -------- 健康检查 --------
# 优先等待镜像 HEALTHCHECK 变为 healthy；镜像没有 HEALTHCHECK 时，脚本用 HTTP
# GET http://127.0.0.1:<实际映射端口>/health 明确验证服务就绪（纯 TCP 连通不算就绪）。
# 需要 curl 或 wget 之一可用；容器 running=false 直接判定未就绪。
CCMAX_HEALTH_TIMEOUT=60
CCMAX_HEALTH_INTERVAL=2

# -------- 密钥文件（可选，推荐）--------
# 绝对路径；必须是普通文件、mode 0600，且位于 config/workspace 之外。
# 内容为 docker --env-file 兼容的 KEY=value 行，例如：
#   ANTHROPIC_AUTH_TOKEN=...
#   ANTHROPIC_BASE_URL=...
#   ANTHROPIC_MODEL=...
# 脚本会在内存中读取内容，校验格式、键集合及哈希；只把文件路径交给 docker，不回显值。
# CCMAX_SECRETS_FILE=/srv/ccmax-runtime/secrets.env

# -------- 工具行为（一般无需修改）--------
# docker 可执行文件（默认 docker）。
# 只支持本机 daemon：在任何 daemon 查询前脚本会用 docker context inspect 只读 context
# 元数据，只接受本机 unix:/// 绝对 socket。DOCKER_HOST / DOCKER_CONTEXT / 当前 current
# context 指向远端（tcp/ssh/npipe 等）时明确拒绝，因为 bind mount、权限检查与备份语义
# 都只在执行脚本的机器上成立；无法确认时同样拒绝（fail closed）。
CCMAX_DOCKER_BIN=docker
# 并发锁目录（默认 $TMPDIR）；需与分析部署的多个实例共享同一文件系统。
# 锁按「解析后的真实本机 endpoint（不是 context 名字）+ 容器名」以及「真实本机 endpoint
# + config 真实路径 / workspace 真实路径」分别加锁，不依赖配置文件路径：共享任一数据目录
# （即使容器名不同）的两个实例互斥，context 别名不能绕过；备份目录会被自动创建为 0700。
# CCMAX_LOCK_BASE=/tmp

# 说明（脚本会强制的其余不变量）：
#   * config / workspace 目录不接受顶层符号链接：tar 只会归档链接本身，备份会看似成功却不可恢复。
#   * config / workspace 目录变化一律人工迁移，任何 flag 都不能绕过。
#   * 镜像自身 Dockerfile ENV 定义的键（PATH / NODE_VERSION / LANG 等）不算「部署方缺失的键」，
#     不需要在密钥文件里复刻。
#   * 回滚指针、元数据与备份归档分别以 0600 / 0600 / 0600 写入，备份目录 0700。